@model BookingMVC.Models.RoomBookingPageViewModel

@{
    ViewData["Title"] = "Rumsbokning";

    var today = DateTime.Today;

    var roomLookup = Model.Rooms.ToDictionary(
        room => room.RoomId,
        room => room.RoomName
    );

    var upcomingBookings = Model.Bookings
        .Where(b => b.Date.Date >= today)
        .OrderBy(b => b.Date)
        .ThenBy(b => b.StartTime)
        .ToList();

    var previousBookings = Model.Bookings
        .Where(b => b.Date.Date < today)
        .OrderByDescending(b => b.Date)
        .ThenByDescending(b => b.StartTime)
        .ToList();

    var shouldHighlightLatest = TempData["HighlightLatest"] != null;
}

<link rel="stylesheet" href="~/css/roombooking.css" />

<div id="title-menu">
    <div>
        <h1>Rumsbokning</h1>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="message-box success-message">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="message-box error-message">
        @TempData["ErrorMessage"]
    </div>
}

<div id="room-booking-page">

    <section class="panel">
        <h2>Boka rum</h2>

        <form asp-action="CreateBooking" method="post" class="booking-form">
            <div class="form-row">
                <label asp-for="NewBooking.RoomId">Rum</label>
                <select asp-for="NewBooking.RoomId" name="RoomId" required>
                    <option value="">Välj rum</option>
                    @foreach (var room in Model.Rooms)
                    {
                        <option value="@room.RoomId">@room.RoomName (@room.Capacity platser)</option>
                    }
                </select>
            </div>

            <div class="form-row">
                <label asp-for="NewBooking.Date">Datum</label>
                <input asp-for="NewBooking.Date" name="Date" type="date" required />
            </div>

            <div class="form-row">
                <label asp-for="NewBooking.StartTime">Starttid</label>
                <input asp-for="NewBooking.StartTime" name="StartTime" type="time" step="1" required />
            </div>

            <div class="form-row">
                <label asp-for="NewBooking.EndTime">Sluttid</label>
                <input asp-for="NewBooking.EndTime" name="EndTime" type="time" step="1" required />
            </div>

            <div class="form-row">
                <label asp-for="NewBooking.ActivityId">ActivityId</label>
                <input asp-for="NewBooking.ActivityId" name="ActivityId" type="number" required />
            </div>

            <div class="form-row">
                <label asp-for="NewBooking.BookedByUserId">BookedByUserId</label>
                <input asp-for="NewBooking.BookedByUserId" name="BookedByUserId" type="number" required />
            </div>

            <div class="form-row">
                <label asp-for="NewBooking.Status">Status</label>
                <input asp-for="NewBooking.Status" name="Status" type="text" />
            </div>

            <button type="submit" class="action-button">Boka</button>
        </form>
    </section>

    <section class="panel">
        <h2>Rum</h2>
        <div class="card-list">
            @foreach (var room in Model.Rooms)
            {
                <div class="info-card">
                    <h3>@room.RoomName</h3>
                    <p><strong>Rums-ID:</strong> @room.RoomId</p>
                    <p><strong>Kapacitet:</strong> @room.Capacity</p>
                </div>
            }
        </div>
    </section>

    <section class="panel" id="bookings-section">
        <div class="section-header">
            <h2>Bokningar</h2>
            <span class="booking-count">Totalt: @Model.Bookings.Count</span>
        </div>

        <div class="booking-group">
            <div class="section-header">
                <h3>Kommande bokningar</h3>
                <span class="booking-count">@upcomingBookings.Count st</span>
            </div>

            @if (upcomingBookings.Any())
            {
                <div class="card-list">
                    @for (int i = 0; i < upcomingBookings.Count; i++)
                    {
                        var booking = upcomingBookings[i];
                        var roomName = roomLookup.ContainsKey(booking.RoomId)
                            ? roomLookup[booking.RoomId]
                            : $"Rum {booking.RoomId}";

                        var cardClass = "info-card booking-card";
                        if (shouldHighlightLatest && i == 0)
                        {
                            cardClass += " newest-booking";
                        }

                        <div class="@cardClass">
                            <div class="booking-card-header">
                                <h3>@roomName</h3>
                                <span class="booking-badge">Bokning #@booking.BookingId</span>
                            </div>

                            <p><strong>Rums-ID:</strong> @booking.RoomId</p>
                            <p><strong>Datum:</strong> @booking.Date.ToString("yyyy-MM-dd")</p>
                            <p><strong>Tid:</strong> @booking.StartTime.ToString(@"hh\:mm") - @booking.EndTime.ToString(@"hh\:mm")</p>
                            <p><strong>Aktivitet:</strong> @booking.ActivityId</p>
                            <p><strong>Bokad av användare:</strong> @booking.BookedByUserId</p>
                            <p><strong>Status:</strong> @booking.Status</p>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    Det finns inga kommande bokningar just nu.
                </div>
            }
        </div>

        <div class="booking-group">
            <div class="section-header">
                <h3>Tidigare bokningar</h3>
                <span class="booking-count">@previousBookings.Count st</span>
            </div>

            @if (previousBookings.Any())
            {
                <div class="card-list">
                    @foreach (var booking in previousBookings)
                    {
                        var roomName = roomLookup.ContainsKey(booking.RoomId)
                            ? roomLookup[booking.RoomId]
                            : $"Rum {booking.RoomId}";

                        <div class="info-card booking-card old-booking">
                            <div class="booking-card-header">
                                <h3>@roomName</h3>
                                <span class="booking-badge">Bokning #@booking.BookingId</span>
                            </div>

                            <p><strong>Rums-ID:</strong> @booking.RoomId</p>
                            <p><strong>Datum:</strong> @booking.Date.ToString("yyyy-MM-dd")</p>
                            <p><strong>Tid:</strong> @booking.StartTime.ToString(@"hh\:mm") - @booking.EndTime.ToString(@"hh\:mm")</p>
                            <p><strong>Aktivitet:</strong> @booking.ActivityId</p>
                            <p><strong>Bokad av användare:</strong> @booking.BookedByUserId</p>
                            <p><strong>Status:</strong> @booking.Status</p>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    Det finns inga tidigare bokningar att visa.
                </div>
            }
        </div>
    </section>

</div>

@if (shouldHighlightLatest)
{
    <script>
        window.location.hash = "bookings-section";
    </script>
}