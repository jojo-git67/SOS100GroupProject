  "roomId": 1,
  "date": "2026-03-12T00:00:00",
  "startTime": "10:15:00",
  "endTime": "11:15:00",
  "activityId": 601,
  "bookedByUserId": 11,
  "status": "ConflictTest"
}

###
# ROOM BOOKINGS - UPDATE (SHOULD FAIL, TIME CONFLICT)
