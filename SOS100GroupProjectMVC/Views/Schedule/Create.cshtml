@model SOS100GroupProjectMVC.Models.ScheduleActivity
@{
    ViewData["Title"] = "Skapa aktivitet";
    Layout = "_Layout";
}
<div class="page-container">
    <h1>Skapa ny aktivitet</h1>
    <form asp-action="Create" method="post">
        <div>
            <label asp-for="CourseId">Kurs-ID</label>
            <input asp-for="CourseId" />
        </div>
        <div>
            <label asp-for="UserId">Användar-ID</label>
            <input asp-for="UserId" />
        </div>
        <div>
            <label asp-for="Title">Titel</label>
            <input asp-for="Title" />
        </div>
        <div>
            <label asp-for="Date">Datum</label>
            <input asp-for="Date" placeholder="2026-03-20" />
        </div>
        <div>
            <label asp-for="StartTime">Starttid</label>
            <input asp-for="StartTime" placeholder="08:15" />
        </div>
        <div>
            <label asp-for="EndTime">Sluttid</label>
            <input asp-for="EndTime" placeholder="10:00" />
        </div>
        <div>
            <label asp-for="RoomId">Rum-ID</label>
            <input asp-for="RoomId" />
        </div>
        <a asp-action="Index" class="btn btn-neka">Avbryt</a>
        <button type="submit" class="btn">Spara</button>
    </form>
</div>