@model List<SOS100GroupProjectMVC.Models.ScheduleActivity>
@{
    ViewData["Title"] = "Schema";
    Layout = "_Layout";
}

<section class="schedule-page">
    <h1>Schema</h1>
    <p>Här kan du se kommande aktiviteter i schemat.</p>

    @if (ViewBag.Success != null)
    {
        <p style="color:green; font-weight:bold;">✅ @ViewBag.Success</p>
    }
    @if (ViewBag.Error != null)
    {
        <p style="color:red; font-weight:bold;">❌ Fel: @ViewBag.Error</p>
    }

    <p>
        <button type="button" class="btn" onclick="öppnaModal()">Skapa ny aktivitet</button>
    </p>

    <h2>Veckoschema</h2>
    <table class="schedule-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Aktivitet</th>
                <th>Datum</th>
                <th>Start</th>
                <th>Slut</th>
                <th>Rum</th>
                <th>Åtgärder</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Count > 0)
            {
                @foreach (var activity in Model)
                {
                    <tr>
                        <td>@activity.ActivityId</td>
                        <td>@activity.Title</td>
                        <td>@activity.Date.ToString("M/d/yyyy")</td>
                        <td>@activity.StartTime.ToString(@"hh\:mm")</td>
                        <td>@activity.EndTime.ToString(@"hh\:mm")</td>
                        <td>@activity.RoomId</td>
                        <td>
                            <div class="actions">
                                <a href="/Schedule/Edit/@activity.ActivityId">Redigera</a>
                                <span>|</span>
                                <a href="/Schedule/Delete/@activity.ActivityId">Ta bort</a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7">Inga aktiviteter hittades.</td>
                </tr>
            }
        </tbody>
    </table>
</section>

<!-- MODAL POPUP -->
<div id="skapaModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%;
     background:rgba(0,0,0,0.5); z-index:1000; justify-content:center; align-items:center; pointer-events:none;">
    <div style="background:#fff; padding:2rem; border-radius:8px; min-width:350px; position:relative;">

        <h2>Skapa aktivitet</h2>

        <form action="/Schedule/Create" method="post">
            <div style="margin-bottom:0.75rem;">
                <label>Kurs-ID</label><br />
                <input type="number" name="CourseId" style="width:100%; padding:4px;" required />
            </div>
            <div style="margin-bottom:0.75rem;">
                <label>Användar-ID</label><br />
                <input type="number" name="UserId" style="width:100%; padding:4px;" required />
            </div>
            <div style="margin-bottom:0.75rem;">
                <label>Titel</label><br />
                <input type="text" name="Title" style="width:100%; padding:4px;" required />
            </div>
            <div style="margin-bottom:0.75rem;">
                <label>Datum</label><br />
                <input type="date" name="Date" value="@DateTime.Now.ToString("yyyy-MM-dd")" style="width:100%; padding:4px;" required />
            </div>
            <div style="margin-bottom:0.75rem;">
                <label>Starttid</label><br />
                <input type="time" name="StartTime" value="08:15" style="width:100%; padding:4px;" required />
            </div>
            <div style="margin-bottom:0.75rem;">
                <label>Sluttid</label><br />
                <input type="time" name="EndTime" value="10:00" style="width:100%; padding:4px;" required />
            </div>
            <div style="margin-bottom:1rem;">
                <label>Rum-ID</label><br />
                <input type="number" name="RoomId" style="width:100%; padding:4px;" required />
            </div>

            <button type="submit" class="btn">Spara</button>
            <button type="button" onclick="stängModal()" style="margin-left:1rem;">Tillbaka</button>
        </form>
    </div>
</div>

<script>
    function öppnaModal() {
        const modal = document.getElementById('skapaModal');
        modal.style.display = 'flex';
        modal.style.pointerEvents = 'auto';
    }

    function stängModal() {
        const modal = document.getElementById('skapaModal');
        modal.style.display = 'none';
        modal.style.pointerEvents = 'none';
    }

    document.getElementById('skapaModal').addEventListener('click', function (e) {
        if (e.target === this) stängModal();
    });
</script>
