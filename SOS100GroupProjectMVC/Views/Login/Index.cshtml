@{
    Layout = null;
    ViewData["Title"] = "Login";
    @model SOS100GroupProjectMVC.DTOs.LoginViewModel;

}
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
<div class="login-container">
    <div class="login-card">
        <h2>Välkommen</h2>
        <p class="login-subtitle">Logga in för att fortsätta</p>

        <form asp-action="Login" asp-controller="Login" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="login-field">
                <label>Användarnamn</label>
                <input asp-for="UserName" placeholder="Ange användarnamn" />
            </div>

            <div class="login-field">
                <label>Lösenord</label>
                <input asp-for="Password" type="password" placeholder="Ange lösenord" />
            </div>

            <button type="submit" class="login-btn">Logga in</button>
        </form>
    </div>
</div>