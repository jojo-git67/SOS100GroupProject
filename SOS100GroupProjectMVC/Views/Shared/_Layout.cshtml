<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
</head>
<body>
<nav>
    <div id="navigation-logo">
        <a asp-action="Index" asp-controller="Home"><h1>Startsida</h1></a>
    </div>
    <div id="navigation-menu">
        <ul>                
            <li><a href=""><i class="fa fa-envelope-o" aria-hidden="true"></i>Meddelanden</a></li>
            @if (Context.Request.Cookies["userId"] != null)
            {
                <li><a href="/Login/Logout"><i class="fa fa-user-circle-o"></i>Logga ut</a></li>
            }
            else
            {
                <li><a href="/Login"><i class="fa fa-user-circle-o"></i>Logga in</a></li>
            }
        </ul>
    </div>
</nav>
<div id="sidebar-menu">
    <ul>
        <li><a href="/Home"><i class="fa fa-home" aria-hidden="true"></i>Hem</a></li>
        <li><a href="#"><i class="fa fa-book" aria-hidden="true"></i>Kurskatalog</a></li>
        <li><a href="/Registrering"><i class="fa fa-plus-square" aria-hidden="true"></i>Registrering</a></li>
        <li><a href="#"><i class="fa fa-calendar" aria-hidden="true"></i>Schema</a></li>
        <li><a href="#"><i class="fa fa-calendar-plus-o" aria-hidden="true"></i>Rumsbokning</a></li>
    </ul>
</div>
<main class="content">
    @RenderBody()
</main>
<script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>