@model SOS100GroupProjectMVC.Models.ScheduleActivity

@{
    ViewData["Title"] = "Redigera aktivitet";
}

<h1>Redigera aktivitet</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="ActivityId" />

    <div>
        <label asp-for="CourseId">Kurs-ID</label>
        <input asp-for="CourseId" />
    </div>

    <div>
        <label asp-for="UserId">Användar-ID</label>
        <input asp-for="UserId" />
    </div>

    <div>
        <label asp-for="Title">Titel</label>
        <input asp-for="Title" />
    </div>

    <div>
        <label asp-for="Date">Datum</label>
        <input asp-for="Date" type="date" />
    </div>

    <div>
        <label asp-for="StartTime">Starttid</label>
        <input asp-for="StartTime" type="time" />
    </div>

    <div>
        <label asp-for="EndTime">Sluttid</label>
        <input asp-for="EndTime" type="time" />
    </div>

    <div>
        <label asp-for="RoomId">Rums-ID</label>
        <input asp-for="RoomId" />
    </div>

    <div>
        <button type="submit">Spara ändringar</button>
        <a asp-action="Index">Avbryt</a>
    </div>
</form>
