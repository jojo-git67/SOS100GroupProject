@model SOS100GroupProjectMVC.Models.CourseViewModel

@{
    ViewData["Title"] = "Redigera kurs";
}

<link rel="stylesheet" href="~/css/courses.css" asp-append-version="true"/>

<h1>Redigera kurs</h1>

<div class="form-container">
    <form method="post" action="/Courses/Edit/@Model.CourseId">
        <input type="hidden" name="CourseId" value="@Model.CourseId" />
        <div class="form-group">
            <label>Titel</label>
            <input type="text" name="Title" value="@Model.Title" required />
        </div>
        <div class="form-group">
            <label>Beskrivning</label>
            <textarea name="Description" required>@Model.Description</textarea>
        </div>
        <div class="form-group">
            <label>Lärare ID</label>
            <input type="number" name="TeacherId" value="@Model.TeacherId" required />
        </div>
        <div class="form-group">
            <label>Max deltagare</label>
            <input type="number" name="MaxParticipants" value="@Model.MaxParticipants" required />
        </div>
        <div class="form-group">
            <label>Startdatum</label>
            <input type="date" name="StartDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" required />
        </div>
        <div class="form-group">
            <label>Slutdatum</label>
            <input type="date" name="EndDate" value="@Model.EndDate.ToString("yyyy-MM-dd")" required />
        </div>
        <div class="form-buttons">
            <button type="submit" class="btn">Spara ändringar</button>
            <a href="/Courses" class="btn">Avbryt</a>
        </div>
    </form>
</div>