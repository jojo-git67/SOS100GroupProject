@model SOS100GroupProjectMVC.Models.CourseViewModel

@{
    ViewData["Title"] = @Model.Title;
}

<link rel="stylesheet" href="~/css/courses.css" asp-append-version="true"/>


<div class="course-details">
    <h1>@Model.Title</h1>
    <p>@Model.Description</p>
    <p><strong>Lärare @Model.TeacherId</strong></p>
    <p>Max deltagare: @Model.MaxParticipants</p>
    <p>Start: @Model.StartDate.ToString("yyyy-MM-dd")</p>
    <p>Slut: @Model.EndDate.ToString("yyyy-MM-dd")</p>

    <div class="card-buttons">
        <a href="/Courses" class="btn">Tillbaka</a>
        <a href="/Courses/Edit/@Model.CourseId" class="btn admin-only">Redigera</a>
        <a href="/Courses/Delete/@Model.CourseId" class="btn admin-only">Ta bort</a>
    </div>
</div>

<script src="~/js/courses.js" asp-append-version="true"></script>