@model SOS100GroupProjectMVC.Models.ScheduleActivity

@{
    ViewData["Title"] = "Ta bort aktivitet";
}

<h1>Ta bort aktivitet</h1>

<p>Är du säker på att du vill ta bort denna aktivitet?</p>

<div>
    <p><strong>Aktivitet:</strong> @Model.Title</p>
    <p><strong>Datum:</strong> @Model.Date.ToString("yyyy-MM-dd")</p>
    <p><strong>Starttid:</strong> @Model.StartTime.ToString(@"hh\:mm")</p>
    <p><strong>Sluttid:</strong> @Model.EndTime.ToString(@"hh\:mm")</p>
    <p><strong>Rum:</strong> @Model.RoomId</p>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="ActivityId" />
    <button type="submit">Ja, ta bort</button>
    <a asp-action="Index">Avbryt</a>
</form>
