@model SOS100GroupProjectMVC.Models.CourseViewModel

@{
    ViewData["Title"] = "Ta bort kurs";
}

<link rel="stylesheet" href="~/css/courses.css" asp-append-version="true"/>

<h1>Ta bort kurs</h1>

<div class="form-container">
    <p>Är du säker på att du vill ta bort kursen:</p>
    <h2>@Model.Title</h2>
    <p>@Model.Description</p>
    <p><strong>Lärare @Model.TeacherId</strong></p>
    <p>Start: @Model.StartDate.ToString("yyyy-MM-dd")</p>
    <p>Slut: @Model.EndDate.ToString("yyyy-MM-dd")</p>

    <form method="post" action="/Courses/Delete/@Model.CourseId">
        <div class="form-buttons">
            <button type="submit" class="btn">Ja, ta bort</button>
            <a href="/Courses" class="btn">Avbryt</a>
        </div>
    </form>
</div>