@{
    ViewData["Title"] = "UniFlow";
}
<div class="home-container">
    <div class="home-header">
        <h1>UniFlow</h1>
        <h3 class="welcome-text">Välkommen, <span id="userName"></span>!</h3>
    </div>
    <div class="home-cards">
        <a href="#" class="home-card">
            <i class="fa fa-book"></i>
            <h3>Kurskatalog</h3>
            <p>Sök och hitta tillgängliga kurser</p>
        </a>
        <a href="/Registrering" class="home-card">
            <i class="fa fa-plus-square"></i>
            <h3>Registrering</h3>
            <p>Registrera dig på kurser och hantera dina ansökningar</p>
        </a>
        <a href="/Schedule" class="home-card">
            <i class="fa fa-calendar"></i>
            <h3>Schema</h3>
            <p>Se ditt personliga schema</p>
        </a>
        <a href="#" class="home-card">
            <i class="fa fa-envelope"></i>
            <h3>Meddelanden</h3>
            <p>Skicka och ta emot meddelanden</p>
        </a>
        <a href="#" class="home-card">
            <i class="fa fa-calendar-plus-o"></i>
            <h3>Rumsbokning</h3>
            <p>Boka rum för möten och studier</p>
        </a>
    </div>
    <div class="home-about">
        <h2>Om UniFlow</h2>
        <p>UniFlow är ett universitetsadministrationssystem som samlar alla viktiga funktioner på ett ställe. 
            Systemet är byggt med en serviceorienterad arkitektur (SOA) där varje tjänst hanterar sitt eget ansvarsområde.</p>
    </div>
</div>
<script src="~/js/site.js"></script>