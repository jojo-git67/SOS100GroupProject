@{
    ViewData["Title"] = "Login";
}

<h1>Login</h1>

<form method="post">
    <div>
        <label>UserId</label>
        <input type="number" name="userId" />
    </div>

    <div>
        <label>Role</label>
        <input type="text" name="role" />
    </div>

    <button type="submit">Logga in</button>
</form>